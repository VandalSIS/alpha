generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InviteStatus {
  INVITED
  STARTED
  IN_PROGRESS
  SUBMITTED
  IN_REVIEW
  COMPLETE
}

model Invitation {
  id          String       @id @default(cuid())
  name        String
  email       String
  code        String       @unique
  status      InviteStatus @default(INVITED)
  /// Custom next-step copy shown on the participant portal (optional).
  nextSteps   String?
  cohortId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invitedAt   DateTime     @default(now())
  startedAt   DateTime?
  submittedAt DateTime?

  cohort      Cohort?          @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  sessions    Session[]
  submission  Submission?
  magicLinks  MagicLink[]
  files       UploadedFile[]
  portalDocs  PortalDocument[]
  caseResponses CaseResponse[]
}

model Cohort {
  id           String              @id @default(cuid())
  name         String
  summary      String?
  createdAt    DateTime            @default(now())
  invitations  Invitation[]
  modules      LearningModule[]
  programmeSessions ProgrammeSession[]
}

model ProgrammeSession {
  id        String    @id @default(cuid())
  title     String
  /// fireside | mock_board | peer | other
  kind      String
  startsAt  DateTime
  location  String?
  notes     String?
  cohortId  String?
  cohort    Cohort?   @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  modules   LearningModule[]
}

model LearningModule {
  id          String     @id @default(cuid())
  title       String
  summary     String
  body        String
  prompt      String?
  relevantFor String?
  published   Boolean    @default(true)
  sortOrder   Int        @default(0)
  cohortId    String?
  sessionId   String?
  createdAt   DateTime   @default(now())
  cohort      Cohort?    @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  session     ProgrammeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  cases       CaseResponse[]
}

model CaseResponse {
  id           String        @id @default(cuid())
  invitationId String
  moduleId     String
  body         String
  submittedAt  DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invitation   Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  module       LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  feedback     CaseFeedback?

  @@unique([invitationId, moduleId])
}

model CaseFeedback {
  id             String       @id @default(cuid())
  caseResponseId String       @unique
  body           String
  authorName     String       @default("Project Alpha team")
  createdAt      DateTime     @default(now())
  caseResponse   CaseResponse @relation(fields: [caseResponseId], references: [id], onDelete: Cascade)
}

model Session {
  id           String     @id @default(cuid())
  token        String     @unique
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
}

model MagicLink {
  id           String     @id @default(cuid())
  token        String     @unique
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  /// "signin" (60 min, one-use) | "resume" (30 days, reusable until expiry)
  purpose      String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
}

model Submission {
  id           String     @id @default(cuid())
  invitationId String     @unique
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  reference    String     @unique
  answers      String // JSON string
  step         Int        @default(0)
  done         Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model UploadedFile {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  fieldId      String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  createdAt    DateTime   @default(now())
}

/// Personal docs (invitationId set) or shared programme resources (invitationId null).
model PortalDocument {
  id           String      @id @default(cuid())
  invitationId String?
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  /// "personal" | "resource"
  kind         String
  title        String
  description  String?
  /// External link (optional if a file is stored)
  url          String?
  category     String?
  storedName   String?
  originalName String?
  mimeType     String?
  size         Int?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  meta      String? // JSON
  createdAt DateTime @default(now())
}
